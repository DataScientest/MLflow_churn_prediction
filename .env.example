# ---- MLflow Configuration ----
# Point all MLflow clients to the central tracking server
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- PostgreSQL (used by MLflow server, NOT by clients directly) ----
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# ---- LLM Provider Configuration ----
# Options: openai (default, Liora LiteLLM gateway), ollama (optional local model)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# LiteLLM gateway (OpenAI-compatible). Both variables are required with LLM_PROVIDER=openai:
# without LITELLM_BASE_URL, the client calls api.openai.com and gets a 401 error.
# Paste the class key given in the course (chapter 07) after LITELLM_KEY=.
LITELLM_BASE_URL=https://ai-gateway.liora.tech/v1
LITELLM_KEY=

# Alternative to LITELLM_*: standard OpenAI SDK variables (used if LITELLM_* are unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://ai-gateway.liora.tech/v1

# Evaluation (src/llm/evaluate_agent.py)
# Agent model used during evaluation (defaults to LLM_PROVIDER / LLM_MODEL)
# AGENT_LLM_PROVIDER=openai
# AGENT_LLM_MODEL=gpt-4o-mini
# LLM-as-a-judge model (default gpt-4o-mini)
# JUDGE_ENABLED=1
# JUDGE_LLM_MODEL=gpt-4o-mini
# JUDGE_BASE_URL=https://ai-gateway.liora.tech/v1
# JUDGE_API_KEY=

# Option: local model with Ollama (uncomment and set LLM_PROVIDER=ollama)
# Slow on a 2-vCPU VM (about 7 min per agent call) and needs about 3.8 GB of RAM.
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Agent Service
AGENT_PORT=8080
