# ---- MLflow Configuration ----
# Point all MLflow clients to the central tracking server
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- PostgreSQL (used by MLflow server, NOT by clients directly) ----
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# ---- LLM Provider Configuration ----
# Options: openai, ollama
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b

# OpenAI Configuration (Required if LLM_PROVIDER=openai)
# Default chat model when LLM_PROVIDER=openai: gpt-4o-mini (override with LLM_MODEL)
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://ai-gateway.liora.tech/v1

# LiteLLM gateway (OpenAI-compatible). If unset, OPENAI_BASE_URL is used.
# LITELLM_KEY=
# LITELLM_BASE_URL=https://ai-gateway.liora.tech/v1

# Evaluation (src/llm/evaluate_agent.py)
# Agent model used during evaluation (defaults to LLM_PROVIDER / LLM_MODEL)
# AGENT_LLM_PROVIDER=openai
# AGENT_LLM_MODEL=gpt-4o-mini
# LLM-as-a-judge model (default gpt-4o-mini)
# JUDGE_ENABLED=1
# JUDGE_LLM_MODEL=gpt-4o-mini
# JUDGE_BASE_URL=https://ai-gateway.liora.tech/v1
# JUDGE_API_KEY=

# Ollama Configuration (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Agent Service
AGENT_PORT=8080
